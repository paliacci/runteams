{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:runteams:marketplace-pipeline:v2",
  "title": "Immutable portable marketplace pipeline v2",
  "$defs": {
    "employee_position": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "kind": {
          "const": "employee"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "employee_ref": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "\\S"
        },
        "skill_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "color": {
          "enum": [
            "gray",
            "brown",
            "orange",
            "yellow",
            "green",
            "blue",
            "purple",
            "pink",
            "red"
          ]
        }
      },
      "required": [
        "key",
        "kind",
        "name",
        "employee_ref",
        "skill_key"
      ],
      "additionalProperties": false
    },
    "approval_position": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "kind": {
          "const": "approval"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "color": {
          "enum": [
            "gray",
            "brown",
            "orange",
            "yellow",
            "green",
            "blue",
            "purple",
            "pink",
            "red"
          ]
        }
      },
      "required": [
        "key",
        "kind",
        "name"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "records_only": {
          "type": "boolean",
          "description": "Completed runs remain in execution records without a board column or task card."
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "pool",
            "done",
            "dropped"
          ]
        },
        "color": {
          "enum": [
            "gray",
            "brown",
            "orange",
            "yellow",
            "green",
            "blue",
            "purple",
            "pink",
            "red"
          ]
        }
      },
      "required": [
        "key",
        "name",
        "kind"
      ],
      "allOf": [{
        "if": {"properties": {"records_only": {"const": true}}, "required": ["records_only"]},
        "then": {"properties": {"kind": {"const": "done"}}}
      }],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "configuration_fields": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$"},
          "minItems": 1,
          "maxItems": 40,
          "uniqueItems": true
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "required": {
          "type": "boolean"
        },
        "required_when": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "constraints": {
          "type": "object",
          "properties": {
            "min_length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8192
            },
            "max_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8192
            },
            "pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "type": {
          "enum": [
            "text",
            "textarea",
            "number",
            "select",
            "multiselect",
            "checklist",
            "checkbox",
            "date",
            "secret"
          ]
        },
        "source": {
          "enum": [
            "user",
            "employee"
          ]
        },
        "display": {
          "enum": [
            "input",
            "handoff",
            "reference",
            "output",
            "setup"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean",
            "array"
          ],
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "writers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "visible_to": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "producers": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "uniqueItems": true,
          "maxItems": 64
        },
        "scope_parameter": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "maxLength": 120
        }
      },
      "required": [
        "key",
        "label",
        "type",
        "source",
        "display"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "secret"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "default"
              ]
            },
            "properties": {
              "display": {
                "const": "setup"
              },
              "key": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,119}$",
                "not": {
                  "enum": [
                    "OPENAI_API_KEY",
                    "ANTHROPIC_API_KEY",
                    "CODEX_ACCESS_TOKEN"
                  ]
                }
              }
            }
          },
          "else": {
            "properties": {
              "key": {
                "pattern": "^[a-z][a-z0-9_-]{0,79}$"
              }
            }
          }
        }
      ]
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "routing_policy": {
          "const": "status-first"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "\\S"
        },
        "positions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/employee_position"
              },
              {
                "$ref": "#/$defs/approval_position"
              }
            ]
          },
          "minItems": 1,
          "maxItems": 64
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 256
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          },
          "maxItems": 64
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          },
          "maxItems": 40
        },
        "delivery": {
          "$ref": "#/$defs/task_delivery"
        },
        "team_standard": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000,
          "pattern": "\\S"
        }
      },
      "required": [
        "name",
        "positions",
        "edges"
      ],
      "if": {
        "required": [
          "routing_policy"
        ]
      },
      "then": {
        "properties": {
          "edges": {
            "items": {
              "properties": {
                "when": {
                  "pattern": "^(?:completed|failed|blocked|needs_human|exception|always|approved|rejected|outcome:\\S(?:[\\s\\S]*\\S)?)$"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "edges": {
            "items": {
              "properties": {
                "when": {
                  "maxLength": 120
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "task_delivery": {
      "type": "object",
      "required": ["parameter", "goals", "sections"],
      "additionalProperties": false,
      "properties": {
        "parameter": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$" },
        "goals": {
          "description": "Ordered sections of the final file for each delivery goal.",
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": { "minLength": 1, "maxLength": 160 },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 24,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$" }
          }
        },
        "sections": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 48,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_-]{0,79}$" },
          "additionalProperties": {
            "type": "object",
            "required": ["title", "output"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S" },
              "output": {
                "description": "Accepted output key and optional report reference path. A bare key requires exactly one saved report.",
                "type": "string",
                "maxLength": 240,
                "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)*$"
              },
              "optional": { "type": "boolean" },
              "images_only": { "type": "boolean" },
              "start_heading": { "type": "string", "minLength": 1, "maxLength": 120 },
              "stop_heading": { "type": "string", "minLength": 1, "maxLength": 120 }
            }
          }
        }
      }
    },
    "pipeline_program_source": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      },
      "required": [
        "key",
        "source"
      ],
      "additionalProperties": false
    },
    "pipeline_program_bundle": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "content_base64": {
          "type": "string",
          "minLength": 1,
          "maxLength": 44739244
        }
      },
      "required": [
        "key",
        "source",
        "sha256",
        "size",
        "content_base64"
      ],
      "additionalProperties": false
    }
  },
  "type": "object",
  "properties": {
    "schema": {
      "const": "runteams.marketplace-pipeline/v2"
    },
    "pipeline": {
      "$ref": "#/$defs/pipeline"
    },
    "avatar": {
      "$ref": "urn:runteams:product-model:v2#/$defs/portable_employee/properties/avatar"
    },
    "avatar_file": {
      "$ref": "urn:runteams:product-model:v2#/$defs/marketplace_employee_asset/properties/avatar_file"
    },
    "workspace_background": {
      "$ref": "urn:runteams:product-model:v2#/$defs/workspace_background_attachment"
    },
    "employees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,79}$"
          },
          "asset": {
            "$ref": "urn:runteams:product-model:v2#/$defs/marketplace_employee_asset"
          }
        },
        "required": [
          "ref",
          "asset"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "program_bundles": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/pipeline_program_bundle"
      }
    },
    "configuration": {
      "$ref": "urn:runteams:product-model:v2#/$defs/employee_configuration"
    }
  },
  "required": [
    "schema",
    "pipeline",
    "employees"
  ],
  "additionalProperties": false
}
