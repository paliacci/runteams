{
  "version": 1,
  "id_pattern": "[a-z][a-z0-9]{7}",
  "device_chat_id_pattern": "local-[a-f0-9]{32}",
  "routes": [
    {
      "internal": "/",
      "public": "/",
      "kind": "home"
    },
    {
      "internal": "/chat/new",
      "public": "/chats/new",
      "kind": "chat-new"
    },
    {
      "internal": "/chat/{chat}",
      "public": "/chats/{chat}",
      "kind": "chat",
      "refs": {
        "chat": "chats"
      }
    },
    {
      "internal": "/bots/{employee}/settings",
      "public": "/employees/{employee}/settings",
      "kind": "bot-settings",
      "refs": {
        "employee": "employees"
      }
    },
    {
      "internal": "/bots/{employee}",
      "public": "/employees/{employee}",
      "kind": "bot",
      "refs": {
        "employee": "employees"
      }
    },
    {
      "internal": "/pipelines/local/{source}/{entry}",
      "public": "/pipelines/local/{source}/{entry}",
      "kind": "source-pipeline",
      "keys": {
        "source": "[a-f0-9]{64}",
        "entry": "[A-Za-z0-9_-]{1,1280}"
      }
    },
    {
      "internal": "/pipelines/new",
      "public": "/pipelines/new",
      "kind": "source-pipeline-new"
    },
    {
      "internal": "/docs/{document}",
      "public": "/documents/{document}",
      "kind": "docs-detail",
      "refs": {
        "document": "documents"
      }
    },
    {
      "internal": "/docs",
      "public": "/documents",
      "kind": "docs"
    },
    {
      "internal": "/trash",
      "public": "/trash",
      "kind": "trash"
    },
    {
      "internal": "/automations",
      "public": "/automations",
      "kind": "automations"
    },
    {
      "internal": "/design-system",
      "public": "/design-system",
      "kind": "design-system"
    }
  ],
  "query_refs": {
    "chat": "chats",
    "employee": "employees",
    "workflow": "workflows"
  }
}
