{
  "version": 1,
  "id_pattern": "[a-z][a-z0-9]{7}",
  "device_page_id_pattern": "[0-9][a-z][a-z0-9]{6}",
  "device_resource_id_pattern": "local-[a-f0-9]{32}",
  "routes": [
    {
      "internal": "/",
      "public": "/",
      "kind": "home"
    },
    {
      "internal": "/chat/new",
      "public": "/chats/new",
      "kind": "chat-new"
    },
    {
      "internal": "/chat/{chat}",
      "public": "/chats/{chat}",
      "kind": "chat",
      "refs": {
        "chat": "chats"
      }
    },
    {
      "internal": "/bots/{employee}/settings",
      "public": "/employees/{employee}/settings",
      "kind": "bot-settings",
      "refs": {
        "employee": "employees"
      }
    },
    {
      "internal": "/bots/{employee}",
      "public": "/employees/{employee}",
      "kind": "bot",
      "refs": {
        "employee": "employees"
      }
    },
    {
      "internal": "/pipelines/new",
      "public": "/pipelines/new",
      "kind": "source-pipeline-new"
    },
    {
      "internal": "/docs/{document}",
      "public": "/documents/{document}",
      "kind": "docs-detail",
      "refs": {
        "document": "documents"
      }
    },
    {
      "internal": "/docs",
      "public": "/documents",
      "kind": "docs"
    },
    {
      "internal": "/trash",
      "public": "/trash",
      "kind": "trash"
    },
    {
      "internal": "/design-system",
      "public": "/design-system",
      "kind": "design-system"
    },
    {
      "internal": "/employees/{employeePage}",
      "public": "/employees/{employeePage}",
      "kind": "employee-work",
      "keys": {
        "employeePage": "[0-9][a-z][a-z0-9]{6}"
      }
    },
    {
      "internal": "/pipelines/{pipeline}",
      "public": "/pipelines/{pipeline}",
      "kind": "source-pipeline",
      "keys": {
        "pipeline": "[0-9][a-z][a-z0-9]{6}"
      }
    },
    {
      "internal": "/employees/{employeePage}/chats/{chat}",
      "public": "/employees/{employeePage}/chats/{chat}",
      "kind": "chat",
      "keys": {
        "employeePage": "[0-9][a-z][a-z0-9]{6}"
      },
      "refs": {
        "chat": "chats"
      }
    },
    {
      "internal": "/pipelines/{pipeline}/chats/{chat}",
      "public": "/pipelines/{pipeline}/chats/{chat}",
      "kind": "chat",
      "keys": {
        "pipeline": "[0-9][a-z][a-z0-9]{6}"
      },
      "refs": {
        "chat": "chats"
      }
    }
  ],
  "query_refs": {
    "chat": "chats",
    "employee": "employees",
    "workflow": "workflows"
  }
}
