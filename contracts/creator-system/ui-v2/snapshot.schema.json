{
  "type": "object",
  "properties": {
    "schema": {
      "const": "runteams.chat-context/2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "chat_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "task_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_mode": {
      "enum": [
        "attached",
        "none"
      ]
    },
    "release_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "view": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "view_input": {
      "anyOf": [
        {
          "type": "object",
          "maxProperties": 32
        },
        {
          "type": "null"
        }
      ]
    },
    "view_context": {
      "anyOf": [
        {
          "type": "object",
          "maxProperties": 32
        },
        {
          "type": "null"
        }
      ]
    },
    "context_revision": {
      "type": "integer",
      "minimum": 0
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "focus": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "id",
            "revision"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "selected": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "type",
          "id",
          "revision"
        ],
        "additionalProperties": false
      }
    },
    "objects": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "type",
              "id",
              "revision"
            ],
            "additionalProperties": false
          },
          "schema_ref": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9/-]*\\.schema\\.json$"
          },
          "data": {
            "type": "object",
            "maxProperties": 32
          },
          "trust": {
            "const": "business-data"
          }
        },
        "required": [
          "ref",
          "schema_ref",
          "data",
          "trust"
        ],
        "additionalProperties": false
      }
    },
    "state": {
      "const": "submitted"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema",
    "id",
    "chat_ref",
    "task_ref",
    "context_mode",
    "release_digest",
    "view",
    "view_input",
    "view_context",
    "context_revision",
    "text",
    "focus",
    "selected",
    "objects",
    "state",
    "input_hash"
  ],
  "additionalProperties": false
}
