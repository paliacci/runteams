      "required": [
        "path",
        "base_revision",
        "operation_key"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "content_base64"
          ],
          "not": {
            "required": [
              "blob_ref"
            ]
          }
        },
        {
          "required": [
            "blob_ref"
          ],
          "not": {
            "required": [
              "content_base64"
            ]
          }
        }
      ]
    },
