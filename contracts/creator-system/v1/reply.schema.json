{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "abi": {
          "const": "runteams.sdk/1"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "ok": {
          "const": true
        },
        "result": {}
      },
      "required": [
        "abi",
        "id",
        "ok",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "abi": {
          "const": "runteams.sdk/1"
        },
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "retry": {
              "enum": [
                "never",
                "read",
                "reconcile",
                "reauthorize"
              ]
            }
          },
          "required": [
            "code",
            "retry"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "abi",
        "id",
        "ok",
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
