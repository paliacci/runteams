        "system.negotiate",
        "source.list",
        "source.read",
        "source.write",
        "source.beginUpload",
        "source.uploadChunk",
        "source.finishUpload",
        "data.query",
        "data.mutate",
        "connection.status",
        "connection.request",
        "connection.http",
        "operation.invoke",
        "operation.receipt",
        "work.dispatch",
        "work.status",
        "events.poll",
        "host.openResult",
        "host.requestDecision"
      ]
    },
    "params": {
      "type": "object"
    }
  },
  "required": [
    "abi",
    "id",
    "method",
    "params"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "system.negotiate"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "sdk": {
                "const": "1.0.0"
              },
              "required": {
                "type": "array",
