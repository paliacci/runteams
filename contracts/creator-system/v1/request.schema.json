                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "offset": {
                "type": "integer",
                "minimum": 0,
                "maximum": 33554432
              },
              "content_base64": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "required": [
              "upload_ref",
              "offset",
              "content_base64"
            ],
            "additionalProperties": false
          }
