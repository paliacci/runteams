              },
              "query": {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "string",
                    "integer",
                    "boolean"
                  ]
                }
              },
              "body": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "operation_key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "required": [
              "connection",
              "endpoint"
            ],
            "additionalProperties": false
          }
        }
