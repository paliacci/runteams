                "maxLength": 240,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\x00-\\x1f:%?#]).+$"
              }
            },
            "required": [
              "path"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "const": "source.write"
          }
        }
      },
