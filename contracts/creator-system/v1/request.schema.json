      "then": {
        "properties": {
          "params": {
            "type": "object",
            "properties": {
              "connection": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
              }
            },
            "required": [
              "connection"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
