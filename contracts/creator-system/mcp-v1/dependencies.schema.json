{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "runteams.dependencies/2"
    },
    "root": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "managed_node"
      ],
      "properties": {
        "protocol": {
          "const": "mcp"
        },
        "managed_node": {
          "const": "24"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{0,79}$"
            },
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "required": [
          "key",
          "version",
          "sha256",
          "requires"
        ],
        "additionalProperties": false
      },
      "maxItems": 256,
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "root",
    "runtime",
    "dependencies"
  ],
  "additionalProperties": false
}
