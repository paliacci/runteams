{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {"const": "runteams.data-models/1"},
    "models": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,79}$"},
          "schema": {"type": "string", "minLength": 1, "maxLength": 240}
        },
        "required": ["type", "schema"], "additionalProperties": false
      }
    }
  },
  "required": ["schema", "models"], "additionalProperties": false
}
