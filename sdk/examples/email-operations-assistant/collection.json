{
  "key": "mail_followups",
  "label": "邮件待跟进",
  "binding": {
    "provider": "local_collection",
    "key": "mail_followups",
    "resource_kind": "collection",
    "access": "read_write",
    "record_schema": {
      "type": "object",
      "required": ["sender", "subject", "snippet", "received_at", "draft"],
      "additionalProperties": false,
      "properties": {
        "sender": {"type": "string", "maxLength": 480},
        "subject": {"type": "string", "maxLength": 600},
        "snippet": {"type": "string", "maxLength": 1600},
        "received_at": {"type": "string", "maxLength": 72},
        "draft": {"type": "string", "maxLength": 12000}
      }
    }
  }
}
